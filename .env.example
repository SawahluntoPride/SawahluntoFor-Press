# =============================================================================
# SawahluntoFor-Press Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit the .env file to version control

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (development)
DATABASE_URL=file:./dev.db

# PostgreSQL (production example)
# DATABASE_URL=postgresql://user:password@localhost:5432/sawahlunto_press?schema=public

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Secret key for signing JWT session tokens
# Must be at least 32 characters long
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_32_character_or_longer_random_string_here

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Node environment (development, production, test)
NODE_ENV=development

# Application port (optional, Next.js defaults to 3000)
PORT=3000

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Maximum file upload size in bytes (default: 4MB)
# MAX_FILE_SIZE=4194304

# Upload directory path (relative to project root)
# UPLOAD_DIR=./uploads
