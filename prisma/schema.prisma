generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  password       String?
  role           Role          @default(MEDIA)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  comments       Comment[]
  proposals      Proposal[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Organization {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  type          OrgType
  description   String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  website       String?
  verified      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  proposals     Proposal[]
  users         User[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  proposals Proposal[]
}

model Proposal {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  orgId           String?
  authorId        String
  categoryId      String?
  status          ProposalStatus @default(DRAFT)
  type            ProposalType?
  scheduledAt     DateTime?
  location        String?
  description     String?
  budget          Int?
  attachments     Json?
  statusNote      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  referenceNumber String?
  comments        Comment[]
  documents       Document[]
  category        Category?      @relation(fields: [categoryId], references: [id])
  author          User           @relation(fields: [authorId], references: [id])
  org             Organization?  @relation(fields: [orgId], references: [id])
}

model Comment {
  id         String   @id @default(cuid())
  proposalId String
  userId     String
  body       String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  proposal   Proposal @relation(fields: [proposalId], references: [id])
}

model Document {
  id         String    @id @default(cuid())
  proposalId String
  name       String
  filename   String
  url        String
  size       Int?
  uploadedAt DateTime  @default(now())
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String?
  proposal   Proposal  @relation(fields: [proposalId], references: [id])
}

enum Role {
  MEDIA
  APPARATUS
  ADMIN
}

enum OrgType {
  MEDIA_OUTLET
  GOV_DEPT
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ProposalType {
  PRESS_RELEASE
  PRESS_CONFERENCE
  MEDIA_VISIT
  INTERVIEW
  EVENT_PARTNERSHIP
}
